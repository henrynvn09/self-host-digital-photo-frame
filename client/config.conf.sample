# Digital Photo Frame Client Configuration (Raspberry Pi 4)
# Copy to config.conf and edit: cp config.conf.sample config.conf

# Synology NAS MagicMirror URL (http://SERVER_IP:SERVER_PORT)
SERVER_IP=192.168.4.45
SERVER_PORT=8036

# Active display schedule (24-hour HH:MM-HH:MM)
MONDAY_FRIDAY=16:00-20:45
SATURDAY_SUNDAY=08:00-20:45

# PIR motion sensor (BCM GPIO pin & idle minutes before screen sleep)
PIR_GPIO_PIN=24
PIR_TIMEOUT_MINUTES=5

# Viewer backend: 'webkit' (~100-140MB RAM, default) or 'chromium'
BROWSER_BACKEND=webkit

DEBUG=false
