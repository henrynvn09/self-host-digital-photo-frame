[Unit]
Description=Digital Photo Frame (WebKitGTK Kiosk + Schedule + PIR)
After=graphical.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__CLIENT_DIR__
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/__USER__/.Xauthority
ExecStart=__CLIENT_DIR__/frame.sh daemon
ExecStop=__CLIENT_DIR__/frame.sh off
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=digitalframe

[Install]
WantedBy=graphical.target
