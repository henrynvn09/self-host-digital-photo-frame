# Synology DSM user/group IDs (find via SSH on NAS: `id <username>`)
PUID=1026
PGID=100

TZ=America/Los_Angeles

# Read-only Synology Photos folder path
#   Shared Space:   /volume1/photo
#   Personal Space: /volume1/homes/<username>/Photos
PHOTOS_PATH=/volume1/photo

# Writable folder on NAS for SQLite index + 1GB LRU 2K preview cache
DATA_PATH=/volume1/docker/photoframe/data

# Shared secret between MagicMirror (config.js) and photo-api
API_KEY=change-me-to-a-random-secret

# Incremental scan interval & optional comma-separated folder exclusions
SCAN_INTERVAL=30m
EXCLUDE_PATTERNS=Screenshots

# 2K (QHD) preview max box (2560x2560 keeps both portrait & landscape sharp on a 27-inch 2K monitor)
MAX_WIDTH=2560
MAX_HEIGHT=2560
JPEG_QUALITY=88

# Preview cache mode: memory (default, 0 disk writes to protect spinning HDDs) | disk | hybrid
CACHE_MODE=memory
CACHE_MAX_MB=1024
MAX_CONCURRENT_DECODES=2

# Optional: set PREBAKE_BLUR=true to pre-composite blurred FRAME_WIDTH x FRAME_HEIGHT bars on the NAS
PREBAKE_BLUR=false
FRAME_WIDTH=1440
FRAME_HEIGHT=2560

# Host port exposed by MagicMirror for the Raspberry Pi client
MAGICMIRROR_PORT=8036
